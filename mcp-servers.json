{
  "tavily-mcp": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "tavily-mcp"
    ],
    "env": {
      "TAVILY_API_KEY": "${TAVILY_API_KEY}"
    }
  },
  "drawio": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "drawio-mcp-server"
    ],
    "env": {}
  },
  "telegram": {
    "type": "stdio",
    "command": "/home/zorkez/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "/home/zorkez/projects/telegram-mcp",
      "/home/zorkez/projects/telegram-mcp/server.py"
    ],
    "env": {}
  }
}
