# Всё игнорируется, в git только белый список
/*
!/.gitignore
!/README.md
!/install.sh
!/mcp.py
!/mcp-servers.json
!/package.json
!/settings.example.json
!/gsd-file-manifest.json
!/agents/
!/commands/
!/hooks/
!/get-shit-done/
!/external/
!/read-once/
/read-once/*
!/read-once/hook.sh
!/read-once/compact.sh
!/read-once/read-once
!/read-once/read-once.ps1
!/plugins/
/plugins/*
!/plugins/known_marketplaces.json
!/skills/
/skills/.trash/
/skills/synced/
/skills/gstack/
__pycache__/
*.pyc
node_modules/
hooks/private-guard.names
hooks/private-guard.off
