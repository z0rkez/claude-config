{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "READ_ONCE_DIFF": "1"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-once/hook.sh"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write|MultiEdit|mcp__obsidian-local-rest-api__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/private-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-guard.py",
            "timeout": 5
          }
        ]
      },
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/read-once/compact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.zaebal/core/zaebal.py --host claude",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session-anchor.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(pacman:-Rns*)",
      "Bash(rm:-rf*)"
    ]
  },
  "switchModelsOnFlag": true
}
